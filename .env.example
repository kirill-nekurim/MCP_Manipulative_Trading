# GigaChat authorization key (base64 of client_id:client_secret)
# https://developers.sber.ru/studio/
GIGACHAT_CREDENTIALS=

# GIGACHAT_API_PERS | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Model name from GigaChat API
GIGACHAT_MODEL=GigaChat

# For local dev without Russian Trusted CA bundle: false
GIGACHAT_VERIFY_SSL_CERTS=false

# Optional: path to CA bundle file
# GIGACHAT_CA_BUNDLE_FILE=/path/to/russian_trusted_root_ca.pem
